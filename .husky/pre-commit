# Caps the heap of every node process the hook spawns — lint-staged included,
# and through it each jest worker. It cannot go in the lint-staged command
# itself: lint-staged spawns without a shell, so an inline `NAME=value` prefix
# is read as the executable name and fails with ENOENT.
export NODE_OPTIONS=--max-old-space-size=1536

npx lint-staged || exit 1

# Whole-tree gates that cost ~0.2s together. They run here rather than on push
# so a broken locale key or a version drift surfaces at the commit that caused
# it, not ten commits later. Invoked directly rather than through `npm run`,
# which would triple the cost in wrapper startup alone.
#
# getVersion() is native, so a platform whose version was not bumped ships
# reporting the previous release: the version-keyed Apollo cache purge never
# fires there and CLIENT_VERSION reaches the server's minimum-version gate
# wrong. Nothing else fails to warn you.
#
# Metro hoists every require above all top-level statements, so the startup
# origin's position is a property of the TRANSFORM, not of index.js. Nothing
# else notices when it drifts and every startup metric silently shortens.
#
# A build that accepts an injected session must never be one anyone else
# receives. Cheap to check, and impossible to notice by reading the diff.
node scripts/check-i18n.mjs || exit 1
node scripts/check-codegen-orphans.mjs || exit 1
node scripts/check-version-sync.mjs || exit 1
node scripts/check-startup-origin.mjs || exit 1
node scripts/check-launch-arg-auth.mjs || exit 1

# The kit (src/components, src/hooks) is what a sibling app reuses wholesale,
# and a feature is only liftable while every feature keeps the same shape. Both
# drift one file at a time and neither is visible in a diff, so both are
# ratchets against a recorded baseline — the baseline is the backlog, and a new
# entry fails here rather than being discovered during an extraction.
node scripts/check-layer-purity.mjs || exit 1
node scripts/check-feature-shape.mjs || exit 1
node scripts/check-dead-modules.mjs || exit 1

# A screen that holds the Apollo client makes every data-layer change a screen
# change, and the tests that render it change too. The baseline is EMPTY, so any
# finding is a regression. Its companion — a hook HANDING a screen a library
# type, which this cannot see because the screen imports nothing — is
# `check-hook-return-types` in pre-push, where the TS program it needs already
# gets built.
node scripts/check-data-layer-boundary.mjs || exit 1

# The kit rule the README states but nothing could see: a shared module used by
# exactly one feature belongs to that feature. Names and imports cannot detect
# it — only counting consumers can. Baseline is the worklist.
node scripts/check-single-consumer.mjs || exit 1

# A form's state belongs to react-hook-form; a feature id in a string outside
# its feature is a place that has to be remembered when the feature list
# changes. Both are ratchets, both may only shrink.
node scripts/check-form-state.mjs || exit 1
node scripts/check-feature-enumeration.mjs || exit 1

# One canonical mechanism per concern — the navigation hook, the date
# formatter, the permission service, the storage layer. Each alternative loses
# what the canonical one already solves; the baseline may only shrink, and a
# concern that reaches zero becomes a lint ban instead.
node scripts/check-canonical-mechanisms.mjs || exit 1

# A literal where a token belongs is a value the theme cannot change. Two of
# its concerns are waiting on a scale that does not exist yet, which is what
# the numbers here are for.
node scripts/check-design-tokens.mjs || exit 1

# A suite that passes its own bare `InMemoryCache` into the shared Apollo helper
# reinstates, for itself alone, the reduced cache every other suite moved off —
# no type policies, no possibleTypes. It is the quietest regression in the tree:
# nothing in that suite's own assertions would notice. Here rather than in jest
# because lint-staged runs jest only over `src/**` related files and pre-push
# runs none at all, so as a test it never ran in the loop that would prevent it.
node scripts/check-test-cache-fidelity.mjs || exit 1

# Comment VOLUME. Long explanatory blocks rot faster than the code they sit on —
# a sweep found 36 wrong comments, one describing the very bug the fix beneath
# it removed. The baseline is EMPTY, so any finding is a regression. Narration
# about what the code used to do is ESLint's `no-warning-comments` instead.
node scripts/check-comment-budget.mjs || exit 1
