# Git feeds this hook one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# A tag push carries no new commits, so every gate below would be judging
# whatever happens to be in the working tree rather than anything being pushed.
# `npm run tag:*` pushes twice — delete, then create — so the whole suite ran
# twice for an operation that ships no code.
only_tags=1
saw_ref=0
# The `|| [ -n "$remote_ref" ]` catches a final line with no trailing
# newline, which `read` reports as EOF after setting the variables.
while read -r _ _ remote_ref _ || [ -n "$remote_ref" ]; do
  saw_ref=1
  case "$remote_ref" in
    refs/tags/*) ;;
    *) only_tags=0 ;;
  esac
done

if [ "$saw_ref" = 1 ] && [ "$only_tags" = 1 ]; then
  echo "pre-push: tag-only push — code gates already ran on the commits behind it."
  exit 0
fi

# The cheap whole-tree checks (i18n, codegen orphans, version sync, startup
# origin, launch-arg auth) run in pre-commit: together they cost ~0.2s, and a
# broken locale key is worth hearing about at the commit that broke it.

# These three are the expensive ones and are independent of each other, so they
# run concurrently — serial they cost ~45s, concurrent ~22s. Each writes to its
# own log so the output stays readable instead of interleaving.
logs=$(mktemp -d)
npm run typecheck                >"$logs/1-typecheck.log"  2>&1 &
pid_tsc=$!
npm run check:compiler-bailouts  >"$logs/2-bailouts.log"   2>&1 &
pid_bailouts=$!
npm run check:unistyles-variants >"$logs/3-variants.log"   2>&1 &
pid_variants=$!

failed=0
wait $pid_tsc      || failed=1
wait $pid_bailouts || failed=1
wait $pid_variants || failed=1

for log in "$logs"/*.log; do cat "$log"; done
rm -rf "$logs"
[ "$failed" -eq 0 ] || exit 1

if ! git diff --quiet HEAD || ! git diff --cached --quiet HEAD; then
  echo "Working tree has uncommitted changes; skipping codegen drift check." >&2
  exit 0
fi

npm run codegen || exit 1

# Every file `npm run codegen` writes. `persisted-query-manifest.json` and the
# derived neutral fillers were missing from this pathspec, so a stale manifest —
# which is what the server matches an operation against — pushed clean.
codegen_outputs="src/graphql/generated/ *.generated.ts persisted-query-manifest.json"

# shellcheck disable=SC2086
if ! git diff --quiet HEAD -- $codegen_outputs; then
  echo "" >&2
  echo "codegen produced changes — your committed generated files are stale." >&2
  echo "Run 'npm run codegen', commit the changes, and push again." >&2
  echo "" >&2
  # shellcheck disable=SC2086
  git diff --stat HEAD -- $codegen_outputs >&2
  exit 1
fi

# The optimistic fillers are generated from the same .graphql documents but by a
# separate script, so `--check` is how a stale one is caught.
npm run check:fillers || exit 1
