# ============================================
# SousChef Mobile App - Environment Variables
# ============================================
# Copy this file to .env.development or .env.production and fill in your values

# ============================================
# API Configuration (Required)
# ============================================
# GraphQL API endpoint for the backend server
API_URL=http://localhost:4000/graphql

# WebSocket endpoint for real-time subscriptions
WEB_SOCKET_URL=ws://localhost:4000/graphql

# API key for authentication with the backend
# Get this from your backend configuration or team
API_KEY=your_api_key_here

# Application environment
# Options: development, production, staging
NODE_ENV=development

# Web app URL (used for deep linking and redirects)
WEB_APP_URL=https://souschef.dev

# ============================================
# Third-Party Services
# ============================================
# Spoonacular API for recipe data and nutrition information
# Get your API key from: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# ============================================
# Telemetry Configuration (Optional)
# ============================================
# Metrics and logs each ship via OTLP (OpenTelemetry Protocol) and have their
# own endpoint + credential pair. Prometheus / Mimir handles metrics, Loki
# handles logs — set them independently. Leave empty to disable.
#
# Grafana Cloud: each stack has its own numeric instance ID + glc_ token,
# so OTLP_METRICS_AUTH_* and OTLP_LOGS_AUTH_* should be different values.
# Self-hosted (single OTLP collector): set both endpoints to the same URL
# and reuse the same credential pair on both sides.

# Both endpoints are BASE URLs — the transport appends /v1/metrics and
# /v1/logs itself. Include whatever base path the backend serves OTLP on
# (Mimir and Loki use /otlp, e.g. https://mimir.example.com/otlp). Getting
# this wrong is silent: every push 404s and the dashboards just stay empty.

# Metrics — sent via OTLP /v1/metrics
OTLP_METRICS_ENDPOINT=
OTLP_METRICS_AUTH_USERNAME=
OTLP_METRICS_AUTH_PASSWORD=

# Logs — sent via OTLP /v1/logs
OTLP_LOGS_ENDPOINT=
OTLP_LOGS_AUTH_USERNAME=
OTLP_LOGS_AUTH_PASSWORD=

# ============================================
# Notes
# ============================================
# - For development, use local endpoints (http://localhost:4000)
# - For production, use secure endpoints (https://api.souschef.dev)
# - Never commit .env files with real credentials to version control
# - The .env.example file should only contain placeholder values
# - Telemetry is optional but recommended for production monitoring
