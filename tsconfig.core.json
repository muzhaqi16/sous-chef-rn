{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string",
      "dom",
      "dom.iterable"
    ],
    "customConditions": [],
    "moduleSuffixes": [""],
    "tsBuildInfoFile": "node_modules/.cache/tsc/core.tsbuildinfo"
  },
  "include": [
    "src/platform/**/*",
    "src/apollo/**/*",
    "src/domain/**/*",
    "src/graphql/**/*",
    "src/i18n/**/*",
    "src/config/**/*",
    "src/store/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/services/auth/**/*",
    "src/services/authService.ts",
    "src/services/subscriptions/**/*",
    "src/services/spoonacular/**/*",
    "src/services/telemetry/**/*",
    "src/services/alertService.ts",
    "src/services/destructiveConfirm.ts",
    "src/services/errorService.ts",
    "src/services/toastService.ts",
    "src/hooks/apollo/**/*",
    "src/hooks/auth/**/*",
    "src/hooks/data/**/*",
    "src/hooks/deepLink/**/*",
    "src/hooks/search/**/*",
    "src/hooks/settings/**/*",
    "src/hooks/utils/**/*",
    "src/hooks/app/**/*",
    "src/hooks/offline/**/*",
    "src/hooks/subscriptions/**/*",
    "src/theme/foundations/**/*",
    "src/features/*/utils/**/*",
    "src/features/*/graphql/**/*",
    "src/features/*/cache/**/*",
    "src/features/*/hooks/**/*",
    "src/features/*/offline/**/*",
    "src/features/*/store/**/*",
    "src/features/*/locales/**/*",
    "src/features/*/constants/**/*",
    "src/features/*/manifest.static.ts",
    "src/features/*/types.ts",
    "src/features/*/pushCopy.ts",
    "src/features/registry.static.ts",
    "src/features/registry.cache.ts",
    "src/features/staticTypes.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/__tests__/**/*",
    "**/__mocks__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
