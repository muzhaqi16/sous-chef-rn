{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods","__tests__"],
  "compilerOptions": {
     "types": ["react-native", "jest", "node"], 
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "#generated": ["./src/graphql/generated"],
      "#hooks": ["./src/hooks"],
      "#hooks/*": ["./src/hooks/*"],
      "#graphql": ["./src/graphql"],
      "#navigation": ["./src/navigation"],
      "#navigation/*": ["./src/navigation/*"],
      "#screens": ["./src/screens"],
      "#screens/*": ["./src/screens/*"],
      "#store": ["./src/store"],
      "#store/*": ["./src/store/*"],
      "#storage": ["./src/storage"],
      "#storage/*": ["./src/storage/*"],
      "#utils": ["./src/utils"],
      "#utils/*": ["./src/utils/*"],
      "#assets": ["./src/assets"],
      "#components": ["./src/components"],
      "#components/*": ["./src/components/*"],
      "#types": ["./src/types"],
      "#config": ["./src/config"],
      "#styles": ["./src/styles"],
      "#services": ["./src/services"],
      "#services/*": ["./src/services/*"]
    }
  }
}
