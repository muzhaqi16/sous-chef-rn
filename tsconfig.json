{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "exclude": ["__tests__/**/*", "**/*.test.ts", "**/*.test.tsx"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "#generated": ["./src/graphql/generated"],
      "#hooks": ["./src/hooks"],
      "#hooks/*": ["./src/hooks/*"],
      "#graphql": ["./src/graphql"],
      "#navigation": ["./src/navigation"],
      "#navigation/*": ["./src/navigation/*"],
      "#screens": ["./src/screens"],
      "#screens/*": ["./src/screens/*"],
      "#store": ["./src/store"],
      "#store/*": ["./src/store/*"],
      "#storage": ["./src/storage"],
      "#storage/*": ["./src/storage/*"],
      "#utils": ["./src/utils"],
      "#utils/*": ["./src/utils/*"],
      "#assets": ["./src/assets"],
      "#components": ["./src/components"],
      "#components/*": ["./src/components/*"],
      "#types": ["./src/types"],
      "#config": ["./src/config"],
      "#styles": ["./src/styles"],
      "#services": ["./src/services"],
      "#services/*": ["./src/services/*"]
    }
  }
}
