          "expr": "sum(rate(graphql_request_duration_ms_sum{job=\"sous-chef-app\"}[5m])) by (name) / sum(rate(graphql_request_duration_ms_count{job=\"sous-chef-app\"}[5m])) by (name)",
          "refId": "B",
          "legendFormat": "Avg {{name}}"
        }
      ],
