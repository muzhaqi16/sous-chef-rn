            "desc": true,
            "displayName": "Count"
          }
        ]
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "topk(15, sum by (event_name) (increase(app_events_total{job=\"sous-chef-app\"}[1h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top User Actions (1h)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "event_name": "Action",
              "Value": "Count"
            }
          }
        }
      ],
      "type": "table"
