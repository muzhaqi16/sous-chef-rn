        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
