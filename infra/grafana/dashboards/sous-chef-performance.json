        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(screen_transition_duration_ms_bucket{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[5m])) by (screen, le))",
          "refId": "A",
          "legendFormat": "Screen: {{screen}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(component_render_duration_ms_bucket{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[5m])) by (component, le))",
          "refId": "B",
          "legendFormat": "Component: {{component}}"
        }
      ],
