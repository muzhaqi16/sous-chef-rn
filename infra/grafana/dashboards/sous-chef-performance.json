          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "title": "Screen-Specific Errors (1h)",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Recipe Detail",
              "Value #B": "Shopping List",
              "Value #C": "Pantry",
              "Value #D": "Onboarding",
              "Value #E": "Navigation",
              "Value #F": "Auth"
            }
          }
        }
      ],
      "type": "table"
    },
