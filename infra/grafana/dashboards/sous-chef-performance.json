        {
          "expr": "sum(increase(shopping_list_errors_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[1h]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum(increase(pantry_errors_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[1h]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum(increase(onboarding_errors_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[1h]))",
          "format": "table",
          "instant": true,
