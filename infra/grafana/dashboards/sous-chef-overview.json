{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Metrics store the mobile app pushes to over OTLP (Mimir).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Log store the mobile app pushes to over OTLP.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "API & GraphQL",
      "tooltip": "",
      "type": "link",
      "url": "/d/sous-chef-api/sous-chef-api-graphql"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "User Analytics",
      "tooltip": "",
      "type": "link",
      "url": "/d/sous-chef-analytics/sous-chef-user-analytics"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Performance",
      "tooltip": "",
      "type": "link",
      "url": "/d/sous-chef-performance/sous-chef-performance-infrastructure"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Total number of app launches across all platforms",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum(app_starts_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"})",
          "refId": "A",
          "legendFormat": "Total Launches"
        }
      ],
      "title": "Total App Launches",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current GraphQL request rate per minute",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum(rate(graphql_requests_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[5m])) * 60",
          "refId": "A",
          "legendFormat": "Requests/min"
        }
      ],
      "title": "GraphQL Requests/min",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Percentage of failed GraphQL requests",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent",
          "decimals": 2,
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(graphql_errors_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[5m])) / clamp_min(sum(rate(graphql_requests_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[5m])), 1e-10)) * 100 or vector(0)",
          "refId": "A",
          "legendFormat": "Error Rate"
        }
      ],
      "title": "GraphQL Error Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Number of app crashes in the last hour",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(app_errors_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\",is_fatal=\"true\"}[1h])) or vector(0)",
          "refId": "A",
          "legendFormat": "Fatal Crashes"
        }
      ],
      "title": "Fatal Crashes (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Login success rate by authentication method",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "id": 29,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "(sum(rate(app_events_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\",event_name=\"login_success\",method=\"email_password\"}[5m])) / sum(rate(app_events_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\",event_name=\"login_attempt\",method=\"email_password\"}[5m]))) * 100",
          "refId": "A",
          "legendFormat": "Email/Password Success Rate"
        },
        {
          "expr": "(sum(rate(app_events_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\",event_name=\"login_success\",method=\"biometric\"}[5m])) / sum(rate(app_events_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\",event_name=\"login_attempt\",method=\"biometric\"}[5m]))) * 100",
          "refId": "B",
          "legendFormat": "Biometric Success Rate"
        }
      ],
      "title": "Login Success Rate",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current memory usage percentage",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "id": 38,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "avg(app_memory_usage_percent{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"})",
          "refId": "A",
          "legendFormat": "Memory Usage %"
        }
      ],
      "title": "Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Unhandled promise rejections",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "id": 23,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum(increase(unhandled_promise_rejections_total{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}[1h])) or vector(0)",
          "refId": "A",
          "legendFormat": "Unhandled Rejections"
        }
      ],
      "title": "Unhandled Promises (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Distinct platform x app-version combinations reporting metrics. NOT a device count: service.instance.id is deliberately coarse ('android_4.4.1') because a per-device metric label is unbounded cardinality. Device identity travels on logs as device_id instead.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "id": 22,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "count(count by(instance)({job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\"}))",
          "refId": "A",
          "legendFormat": "Active Instances"
        }
      ],
      "title": "Reporting Build Variants",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Median app_startup_duration_ms. Scope it with the App version / Device type pickers: emulator and physical sessions differ by 1.4-2x, so the unscoped number tracks the sample mix. Per-build comparison lives on the Performance dashboard.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2000
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "id": 30,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(app_startup_duration_ms_bucket{job=\"sous-chef-app\",env=~\"$environment\",platform=~\"$platform\",version=~\"$version\",device_type=~\"$device_type\"}[5m])) by (le))",
          "refId": "A",
          "legendFormat": "Median Startup"
        }
      ],
      "title": "Median Startup (ms)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Error log volume over time",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 100,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 40,
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"sous-chef-app\"} | json | level=\"error\" | env=~\"$environment\" | platform=~\"$platform\" [5m]))",
          "refId": "A",
          "legendFormat": "Errors"
        }
      ],
      "title": "Error Log Volume",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Error logs grouped by error class (OTel exception.type structured metadata). Empty for logs from app builds without exception semconv.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 100,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 42,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum by (exception_type) (count_over_time({service_name=\"sous-chef-app\"} | json | level=\"error\" | env=~\"$environment\" | platform=~\"$platform\" | exception_type != \"\" [5m]))",
          "refId": "A",
          "legendFormat": "{{exception_type}}"
        }
      ],
      "title": "Errors by Type",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Recent error logs from the app",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 41,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "{service_name=\"sous-chef-app\"} | json | level=\"error\" | env=~\"$environment\" | platform=~\"$platform\"",
          "refId": "A"
        }
      ],
      "title": "Recent Error Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "style": "dark",
  "tags": ["react-native", "mobile", "sous-chef", "overview"],
  "templating": {
