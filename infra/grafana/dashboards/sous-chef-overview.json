        "options": [],
        "query": "label_values({job=\"sous-chef-app\",env=~\"$environment\"}, device_type)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
