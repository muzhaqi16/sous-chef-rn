          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values({job=\"sous-chef-app\",env=~\"$environment\"}, version)",
        "allValue": ".*",
        "hide": 0,
        "includeAll": true,
        "label": "App version",
        "multi": true,
        "name": "version",
        "options": [],
        "query": "label_values({job=\"sous-chef-app\",env=~\"$environment\"}, version)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values({job=\"sous-chef-app\",env=~\"$environment\"}, device_type)",
        "allValue": ".*",
        "hide": 0,
