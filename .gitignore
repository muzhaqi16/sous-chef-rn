android/app/google-services.json
ios/GoogleService-Info.plist

# node.js
#
node_modules/
yarn.lock
npm-debug.log
yarn-error.log

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Bundle analysis output
output.js
output.js.map

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage
.eslintcache

# Yarn
.yarn/*

*.env
.env.local
.env.production
.env.staging
.env.development
# react-native-config codegen
ios/tmp.xcconfig
.claude/
.codex/
.mcp.json
.vscode/mcp.json
.agents/
openspec/

artifacts/
e2e/artifacts/

# GraphQL codegen output (regenerated in CI; schema.graphql is the source of truth and stays tracked)
**/*.generated.ts
src/graphql/generated/schemaTypes.ts
src/graphql/generated/fragmentMatcher.json

# Generated build-time config (see scripts/generate-env.js)
src/config/env.generated.ts

# Audit write-ups are scratch: per-session and per-machine, and a measurement is
# only comparable against one taken on the SAME hardware minutes later, so there
# is nothing here worth committing. Conclusions that must outlive a session
# belong in the rule they justify — CLAUDE.md, or the doc under docs/ that owns
# the topic — stated with its number, not as a pointer to a file no clone has.
docs/audits/*

# Reassure measurements. Per-run and per-machine — a baseline is only
# comparable against a current measured on the SAME machine minutes later,
# so there is nothing here worth committing.
.reassure/

# Watchman probe files. Watchman drops these into the watched root to verify it
# is receiving filesystem notifications, then deletes them; one is left behind
# whenever a watch dies mid-check. Transient, machine-named, never ours to
# commit.
.watchman-cookie-*
