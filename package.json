{
  "name": "sous-chef-app",
  "version": "0.9.7",
  "private": true,
  "scripts": {
    "android": "npm run adb:gql && npm run codegen && react-native run-android",
    "android:stg": "npm run adb:gql && npm run codegen && npx react-native run-android --mode=staging",
    "android:release": "npx react-native run-android --mode=release",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "reset:cache": "npx react-native start --reset-cache",
    "android:clean": "cd android && gradlew clean",
    "android:build": "npx react-native build-android --mode=release",
    "android:build:prod": "npm run android:clean && npx react-native build-android --mode=release",
    "adb:log": "adb logcat *:S ReactNative:V ReactNativeJS:V",
    "adb:gql": "adb reverse tcp:4000 tcp:4000",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --watch --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "watchman": "watchman watch-del-all && watchman shutdown-server",
    "test": "jest",
    "tag:dev": "node -e \"const v=require('./package.json').version; const t='v'+v; require('child_process').execSync('git tag -a '+t+' -m \\\"Release '+t+'\\\"', {stdio:'inherit'}); require('child_process').execSync('git push origin '+t, {stdio:'inherit'})\"",
    "tag:prod": "node -e \"const v=require('./package.json').version; const t='prod-v'+v; require('child_process').execSync('git tag -a '+t+' -m \\\"Production release '+t+'\\\"', {stdio:'inherit'}); require('child_process').execSync('git push origin '+t, {stdio:'inherit'})\"",
    "tag:android": "node -e \"const v=require('./package.json').version; const t='android-v'+v; require('child_process').execSync('git tag -a '+t+' -m \\\"Android release '+t+'\\\"', {stdio:'inherit'}); require('child_process').execSync('git push origin '+t, {stdio:'inherit'})\"",
    "tag:release": "node -e \"const v=require('./package.json').version; const t='release-v'+v; require('child_process').execSync('git tag -a '+t+' -m \\\"Release '+t+'\\\"', {stdio:'inherit'}); require('child_process').execSync('git push origin '+t, {stdio:'inherit'})\""
  },
  "dependencies": {
    "@apollo/client": "^4.0.5",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/image-editor": "^4.3.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "^2.11.1",
    "@react-native-vector-icons/common": "^12.0.0",
    "@react-native-vector-icons/feather": "^12.3.0",
    "@react-native-vector-icons/ionicons": "^12.3.0",
    "@react-native-vector-icons/material-design-icons": "^12.3.0",
    "@react-native-vector-icons/material-icons": "^12.3.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.12",
    "@react-navigation/stack": "^7.4.8",
    "date-fns": "^4.1.0",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "immer": "^10.1.1",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-hook-form": "^7.56.2",
    "react-native": "^0.81.4",
    "react-native-config": "^1.5.9",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^3.3.1",
    "react-native-nitro-modules": "^0.28.0",
    "react-native-permissions": "^5.4.2",
    "react-native-reanimated": "^4.1.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.12.0",
    "react-native-unistyles": "^3.0.12",
    "react-native-vision-camera": "^4.7.2",
    "react-native-worklets": "^0.5.1",
    "react-native-worklets-core": "^1.6.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "yup": "^1.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/runtime": "^7.28.4",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/fragment-matcher": "^6.0.0",
    "@graphql-codegen/introspection": "^5.0.0",
    "@graphql-codegen/schema-ast": "^5.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "^0.81.4",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "prettier": "3.5.3",
    "react-test-renderer": "19.1.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}