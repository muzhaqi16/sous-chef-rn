{
  "name": "sous-chef-app",
  "version": "2.1.6",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "react-native run-android",
    "android:stg": "ENVFILE=.env.staging react-native run-android",
    "android:prod": "ENVFILE=.env.production react-native run-android",
    "android:release": "npx react-native run-android --mode=release",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:build:bundle": "cd android && ./gradlew bundleRelease",
    "android:install:release": "adb install -r android/app/build/outputs/apk/release/app-arm64-v8a-release.apk",
    "android:all": "npm run adb:gql:all && for device in $(adb devices | tail -n +2 | cut -f1 | grep -v '^$'); do echo \"Running on $device\" && npx react-native run-android --device=\"$device\"; done",
    "android:stg:all": "npm run adb:gql:all && npm run codegen && for device in $(adb devices | tail -n +2 | cut -f1 | grep -v '^$'); do echo \"Running on $device\" && npx react-native run-android --mode=staging --device=\"$device\"; done",
    "android:release:all": "npm run adb:gql:all && for device in $(adb devices | tail -n +2 | cut -f1 | grep -v '^$'); do echo \"Running on $device\" && npx react-native run-android --mode=release --device=\"$device\"; done",
    "android:device": "[ -z \"$DEVICE_ID\" ] && npx react-native run-android || npx react-native run-android --device=\"$DEVICE_ID\"",
    "android:stg:device": "npm run codegen && ([ -z \"$DEVICE_ID\" ] && npx react-native run-android --mode=staging || npx react-native run-android --mode=staging --device=\"$DEVICE_ID\")",
    "android:emulator": "npm run adb:gql:emulator && npx react-native run-android --device=$(adb devices | grep emulator | head -1 | cut -f1)",
    "android:phone": "npm run adb:gql:phone && npx react-native run-android --device=$(adb devices | grep -v emulator | grep device | head -1 | cut -f1)",
    "adb:devices": "adb devices -l",
    "adb:devices:count": "echo \"Connected devices: $(adb devices | tail -n +2 | grep device | wc -l)\"",
    "adb:kill": "adb kill-server",
    "adb:gql": "adb reverse tcp:4000 tcp:4000",
    "adb:gql:remove": "adb reverse --remove tcp:4000",
    "adb:gql:reset": "adb reverse --remove tcp:4000 && adb reverse tcp:4000 tcp:4000",
    "adb:gql:all": "for device in $(adb devices | tail -n +2 | cut -f1 | grep -v '^$'); do echo \"Setting up $device\" && adb -s \"$device\" reverse tcp:4000 tcp:4000; done",
    "adb:gql:emulator": "adb -e reverse tcp:4000 tcp:4000",
    "adb:gql:phone": "adb -d reverse tcp:4000 tcp:4000",
    "adb:log": "adb logcat *:S ReactNative:V ReactNativeJS:V",
    "adb:log:app": "adb logcat -c && adb logcat '*:E' | grep -E \"(FATAL|AndroidRuntime|souschef|ReactNative)\"",
    "adb:log:device": "[ -z \"$DEVICE_ID\" ] && adb logcat *:S ReactNative:V ReactNativeJS:V || adb -s \"$DEVICE_ID\" logcat *:S ReactNative:V ReactNativeJS:V",
    "adb:clear:all": "for device in $(adb devices | tail -n +2 | cut -f1 | grep -v '^); do echo \"Clearing reverses on $device\" && adb -s \"$device\" reverse --remove-all; done",
    "android:clean": "cd android && ./gradlew clean",
    "android:build": "npx react-native build-android --mode=release",
    "android:build:prod": "npm run android:clean && npx react-native build-android --mode=release",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "reset:cache": "npx react-native start --reset-cache",
    "npm:clean": "rm -rf node_modules/ && npm cache clean --force",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --watch --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "watchman": "watchman watch-del-all && watchman shutdown-server",
    "test": "jest",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "test:e2e:android:device": "detox test --configuration android.att.debug",
    "test:e2e:android:device:reuse": "detox test --configuration android.att.debug --reuse",
    "test:e2e:build:android:device": "watchman watch-del-all && rm -rf /tmp/metro-* /tmp/haste-map-* /tmp/react-* && detox build --configuration android.att.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:build": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "watchman watch-del-all && rm -rf /tmp/metro-* /tmp/haste-map-* /tmp/react-* && detox build --configuration android.emu.debug",
    "test:e2e:rebuild": "detox rebuild-framework-cache",
    "test:e2e:clean": "detox clean-framework-cache",
    "audit:theme": "node scripts/audit-theme-tokens.js",
    "audit:theme:detailed": "node scripts/audit-theme-tokens.js --detailed",
    "postinstall": "patch-package",
    "tag:dev": "node scripts/create-tag.mjs dev",
    "tag:stg": "node scripts/create-tag.mjs stg",
    "tag:prod": "node scripts/create-tag.mjs prod",
    "tag:playstore": "node scripts/create-tag.mjs playstore"
  },
  "dependencies": {
    "@apollo/client": "^4.0.10",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-community/image-editor": "^4.3.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-native-vector-icons/common": "^12.4.0",
    "@react-native-vector-icons/feather": "^12.4.0",
    "@react-native-vector-icons/ionicons": "^12.3.0",
    "@react-native-vector-icons/material-design-icons": "^12.4.0",
    "@react-native-vector-icons/material-icons": "^12.4.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "@react-navigation/stack": "^7.6.12",
    "@shopify/react-native-skia": "^2.4.7",
    "date-fns": "^4.1.0",
    "fractional-indexing": "^3.2.0",
    "graphql": "^16.12.0",
    "graphql-ws": "^6.0.6",
    "immer": "^11.0.1",
    "jwt-decode": "^4.0.0",
    "react": "19.1.1",
    "react-hook-form": "^7.56.2",
    "react-native": "^0.82.1",
    "react-native-config": "^1.6.0",
    "react-native-device-info": "^15.0.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.1.0",
    "react-native-nitro-modules": "^0.30.2",
    "react-native-pager-view": "^7.0.2",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "^4.2.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-svg": "^15.12.0",
    "react-native-tab-view": "^4.2.1",
    "react-native-unistyles": "^3.0.17",
    "react-native-vision-camera": "^4.7.2",
    "react-native-worklets": "^0.7.1",
    "react-native-worklets-core": "^1.6.2",
    "uuid": "^13.0.0",
    "victory-native": "^41.20.2",
    "yup": "^1.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.28.4",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/fragment-matcher": "^6.0.0",
    "@graphql-codegen/introspection": "^5.0.0",
    "@graphql-codegen/schema-ast": "^5.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@react-navigation/devtools": "^7.0.45",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/jwt-decode": "^2.2.1",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "detox": "^20.46.0",
    "eslint": "^8.19.0",
    "eslint-plugin-ft-flow": "^2.0.3",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.13.3",
    "hermes-eslint": "^0.32.0",
    "jest": "^29.6.3",
    "jest-circus": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
